# PlatformIO build output and downloaded libraries
.pio/

# PlatformIO-generated VS Code files (recreated on every project load)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ESP-IDF: generated configs (one per PlatformIO env, e.g. sdkconfig.louder),
# keep the hand-written sdkconfig.defaults
sdkconfig
sdkconfig.*
!sdkconfig.defaults
build/
managed_components/

# Compiler / linker output from builds outside PlatformIO
*.o
*.obj
*.d
*.a
*.elf
*.bin
*.map
*.dSYM/

# Python tooling (e.g. clap tuning scripts)
__pycache__/
*.pyc
.venv/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*~

# Claude Code: personal settings
.claude/settings.local.json
